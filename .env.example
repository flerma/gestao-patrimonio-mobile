# Variáveis do app mobile. Copie para .env.local (não versionado) para uso local.
# Nos builds do EAS os valores vêm do bloco "env" de cada perfil no eas.json.

# Ambiente: development | production. Em production a URL da API é fixa
# (a troca em Ajustes fica oculta). `npm run start:prod` já define production.
APP_ENV=development

# URL do backend. Vazio = app.json extra.apiBaseUrl (http://10.0.2.2:8080,
# o localhost da máquina visto do emulador Android). Em aparelho físico use o
# IP da máquina na rede, ex.: http://192.168.0.10:8080
# Produção: https://api.gestaoseupatrimonio.com.br
EXPO_PUBLIC_API_BASE_URL=

# Login com Google (client ID "Aplicativo da Web"; o iOS só se for publicar no iPhone).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
